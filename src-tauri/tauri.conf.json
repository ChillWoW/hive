{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Hive",
    "mainBinaryName": "Hive",
    "version": "0.0.1",
    "identifier": "com.hive",
    "build": {
        "frontendDist": "../build",
        "devUrl": "http://localhost:1421",
        "beforeDevCommand": "bun run dev",
        "beforeBuildCommand": "bun run build"
    },
    "app": {
        "windows": [
            {
                "title": "Hive",
                "width": 1200,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600,
                "decorations": false,
                "dragDropEnabled": false,
                "zoomHotkeysEnabled": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBMzM1N0M4RDY5Njg3QzYKUldUR2g1Yld5RmN6Mm1tYmExckxUUmNkdmRaYm14ZUt6MjVnZDdDelBRekZRZVdKOGFoTVhvYlUK",
            "endpoints": [
                "https://github.com/ChillWoW/hive/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": ["app", "dmg", "nsis"],
        "icon": [
            "icons/prod/32x32.png",
            "icons/prod/128x128.png",
            "icons/prod/128x128@2x.png",
            "icons/prod/icon.icns",
            "icons/prod/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installerIcon": "icons/prod/icon.ico",
                "uninstallerIcon": "icons/prod/icon.ico"
            }
        }
    }
}
